{
  "id": "ci-watch",
  "title": "Taxiway – CI watch agent (nightly workflows)",
  "schedule": "0 4,7 * * *",
  "model": "default",
  "repositories": {
    "taxiway-sh/taxiway": "read",
    "taxiway-sh/agents": "write"
  },
  "workdir": "taxiway",
  "skills": ["taxiway-testing", "taxiway-intake", "taxiway-upstream", "taxiway-security"],
  "outputs": ["report", "status/ci-watch.json"],
  "autonomy": {
    "comment-issue": "ask",
    "create-issue": "ask",
    "rerun-workflow": "ask"
  }
}
