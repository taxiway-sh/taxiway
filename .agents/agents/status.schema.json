{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scheduled agent heartbeat (status/<id>.json in taxiway-sh/agents)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "result", "summary", "waiting", "promptVersion"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "date": {"type": "string", "format": "date-time"},
    "result": {"enum": ["ok", "partial", "failed"]},
    "summary": {"type": "string", "maxLength": 300},
    "waiting": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["link", "action"],
        "properties": {
          "link": {"type": "string", "pattern": "^https://github\\.com/"},
          "action": {"type": "string", "maxLength": 200}
        }
      }
    },
    "promptVersion": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approvals": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "proposal", "answer", "date", "link"],
        "properties": {
          "class": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "proposal": {"type": "string", "maxLength": 200, "pattern": "^([a-z0-9-]+-[0-9]{8}-[0-9]+|https://github\\.com/taxiway-sh/.+)$"},
          "answer": {"enum": ["ok", "refused", "corrected"]},
          "date": {"type": "string", "format": "date-time"},
          "link": {"type": "string", "pattern": "^https://github\\.com/taxiway-sh/"}
        }
      }
    },
    "frictions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary"],
        "properties": {
          "kind": {"enum": ["missing-rule", "ambiguous-rule", "contradictory-rule", "workaround", "check-not-run", "tool-refused"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 200},
          "link": {"type": "string", "pattern": "^https://github\\.com/taxiway-sh/"}
        }
      }
    }
  }
}
